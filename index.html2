<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111827">
<title>Modren Bank</title>
<style>
:root{
  --bg:#0b1020;--panel:#121a2d;--panel2:#18233b;--text:#f5f7fb;--muted:#9ca8bf;
  --line:#293550;--primary:#6d7cff;--primary2:#8b5cf6;--good:#22c55e;--bad:#ef4444;--warn:#f59e0b;
  --shadow:0 18px 50px rgba(0,0,0,.28);--radius:20px
}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:
radial-gradient(circle at 10% 0%,#26345e 0,transparent 32%),linear-gradient(145deg,#070b16,#10182b 55%,#0b1020);
color:var(--text);min-height:100vh}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.hidden{display:none!important}.app{min-height:100vh}.topbar{height:72px;display:flex;align-items:center;gap:12px;padding:12px 18px;
border-bottom:1px solid var(--line);background:rgba(9,14,28,.78);backdrop-filter:blur(16px);position:sticky;top:0;z-index:20}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:20px;flex:1}.logo{width:40px;height:40px;border-radius:13px;
display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--primary2));box-shadow:0 10px 28px #5967ff44}
.iconbtn{width:44px;height:44px;border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:14px}
.layout{display:grid;grid-template-columns:250px 1fr;min-height:calc(100vh - 72px)}
.sidebar{border-right:1px solid var(--line);padding:16px;background:rgba(10,15,29,.7);position:sticky;top:72px;height:calc(100vh - 72px);overflow:auto}
.nav{display:flex;flex-direction:column;gap:7px}.nav button{text-align:start;border:0;background:transparent;color:var(--muted);padding:13px 14px;border-radius:14px}
.nav button:hover,.nav button.active{background:linear-gradient(90deg,#6d7cff22,#8b5cf622);color:#fff}.content{padding:24px;max-width:1500px;width:100%;margin:auto}
.pagehead{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:20px}.pagehead h1{margin:0;font-size:28px}.muted{color:var(--muted)}
.grid{display:grid;gap:16px}.cards{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.two{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.card{background:linear-gradient(180deg,rgba(24,35,59,.94),rgba(16,24,42,.94));border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)}
.stat{font-size:30px;font-weight:800;margin-top:8px}.statlabel{color:var(--muted);font-size:13px}.pill{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:999px;font-size:12px;background:#ffffff10;border:1px solid #ffffff12}
.good{color:#7cf3a1}.bad{color:#ff8e8e}.warn{color:#ffd27a}
.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:0;border-radius:13px;padding:11px 15px;color:white;background:linear-gradient(135deg,var(--primary),var(--primary2));font-weight:700}
.btn.secondary{background:#ffffff0b;border:1px solid var(--line)}.btn.danger{background:linear-gradient(135deg,#ef4444,#b91c1c)}
.btn.good{background:linear-gradient(135deg,#22c55e,#15803d)}.btn.small{padding:8px 10px;font-size:12px}
.form{display:grid;gap:12px}.field{display:grid;gap:6px}.field label{font-size:13px;color:var(--muted)}input,select,textarea{
width:100%;padding:12px 13px;border-radius:12px;border:1px solid var(--line);background:#080e1c;color:var(--text);outline:none}
input:focus,select:focus,textarea:focus{border-color:#7180ff;box-shadow:0 0 0 3px #7180ff1c}
.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:16px}.table{width:100%;border-collapse:collapse;min-width:700px}.table th,.table td{padding:12px 13px;border-bottom:1px solid var(--line);text-align:start}.table th{color:var(--muted);font-size:12px}
.empty{text-align:center;padding:35px;color:var(--muted)}.section{margin-top:22px}.section h2{font-size:18px;margin:0 0 12px}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#111a2d;border:1px solid var(--line);padding:12px 16px;border-radius:14px;box-shadow:var(--shadow);z-index:100;max-width:90%}
.modal{position:fixed;inset:0;background:#0008;display:grid;place-items:center;padding:20px;z-index:90}.modalbox{width:min(650px,100%);max-height:90vh;overflow:auto;background:#111a2d;border:1px solid var(--line);border-radius:24px;padding:22px}
.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.authbox{width:min(460px,100%);background:#111a2df2;border:1px solid var(--line);border-radius:28px;padding:30px;box-shadow:var(--shadow)}
.authlogo{margin:auto auto 18px;width:62px;height:62px;border-radius:20px;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--primary2));font-size:28px}
.tabs{display:flex;gap:7px;overflow:auto;margin-bottom:15px}.tabs button{white-space:nowrap;border:1px solid var(--line);background:#ffffff08;color:var(--muted);padding:9px 12px;border-radius:11px}.tabs button.active{color:white;background:#6d7cff25;border-color:#7180ff66}
.kpi{display:flex;justify-content:space-between;gap:10px;align-items:center}.dangerzone{border-color:#ef444455;background:#ef44440a}
@media(max-width:850px){.layout{grid-template-columns:1fr}.sidebar{position:fixed;z-index:50;left:0;top:72px;width:260px;transform:translateX(-105%);transition:.2s}.sidebar.open{transform:translateX(0)}.content{padding:16px}.pagehead h1{font-size:23px}}
[dir="rtl"] .sidebar{border-right:0;border-left:1px solid var(--line)}
@media(max-width:850px){[dir="rtl"] .sidebar{right:0;left:auto;transform:translateX(105%)}[dir="rtl"] .sidebar.open{transform:translateX(0)}}
</style>
</head>
<body>
<div id="root"></div>
