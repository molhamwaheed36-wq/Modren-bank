}}
};
let state=load();
function load(){try{const x=JSON.parse(localStorage.getItem(KEY));return x||fresh()}catch(e){return fresh()}}
function fresh(){return {version:3,settings:{lang:"en",theme:"dark",bankName:"Modren Bank",defaultGame:"Modren Empire",updateUrl:""},users:[],games:[],currencies:[],products:[],transactions:[],permissions:[],session:null}}
function save(){localStorage.setItem(KEY,JSON.stringify(state))}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function t(k){return (LANGS[state.settings.lang]||LANGS.en).t[k]||LANGS.en.t[k]||k}
function setLang(){document.documentElement.lang=state.settings.lang;document.documentElement.dir=LANGS[state.settings.lang].dir}
function toast(msg){const d=document.createElement("div");d.className="toast";d.textContent=msg;document.body.appendChild(d);setTimeout(()=>d.remove(),2300)}
function uid(p="id"){return p+"_"+Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-4)}
async function hash(s){if(window.crypto?.subtle){const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(s));return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("")}return btoa(unescape(encodeURIComponent(s)))}
function fmt(n){return Number(n||0).toLocaleString(state.settings.lang==="ar"?"ar":state.settings.lang)}
function statusPill(s){const m={active:"good",frozen:"warn",banned:"bad"};return `<span class="pill ${m[s]||""}">${esc(t(s)||s)}</span>`}
function render(){setLang();document.body.innerHTML=state.session?appHTML():authHTML();bind()}
function authHTML(){
 const setup=state.users.length===0;
 return `<div class="auth"><div class="authbox">
 <div class="authlogo">₥</div><h1 style="text-align:center;margin:0">${esc(t("loginTitle"))}</h1>
 <p class="muted" style="text-align:center">${esc(t("tag"))}</p>
 <div class="card" style="padding:14px;margin:18px 0;background:#ffffff06">${setup?"👑 "+esc(t("needSetup")):"🔐 "+esc(t("local"))}</div>
 <form id="authForm" class="form">
 <div class="field"><label>${esc(t("user"))}</label><input id="au" required autocomplete="username"></div>
 <div class="field"><label>${esc(t("pass"))}</label><input id="ap" required type="password" autocomplete="current-password"></div>
 ${setup?`<div class="field"><label>${esc(t("confirm"))}</label><input id="ac" required type="password"></div>`:""}
 <button class="btn">${esc(setup?t("setup"):t("login"))}</button></form>
 <div class="section"><div class="field"><label>${esc(t("language"))}</label><select id="lang">${Object.entries(LANGS).map(([k,v])=>`<option value="${k}" ${k===state.settings.lang?"selected":""}>${v.name}</option>`).join("")}</select></div></div>
 <p class="muted" style="font-size:12px;margin-top:16px">${esc(t("warning"))}</p>
 </div></div>`
}
function appHTML(){
 const u=state.users.find(x=>x.id===state.session); const title=state.page||"dashboard";
 const nav=[["dashboard","⌂"],["users","👥"],["games","🎮"],["currencies","◈"],["products","🛒"],["transactions","↔"],["permissions","🔑"],["settings","⚙"],["backup","💾"]];
 return `<div class="app"><header class="topbar"><button class="iconbtn" id="menu">☰</button><div class="brand"><span class="logo">₥</span>${esc(state.settings.bankName)}</div><span class="pill">${esc(u?.username||"")}</span><button class="iconbtn" id="logout">↪</button></header>
 <div class="layout"><aside class="sidebar" id="side"><nav class="nav">${nav.map(([k,i])=>`<button class="${title===k?"active":""}" data-nav="${k}">${i} ${esc(t(k))}</button>`).join("")}</nav></aside>
 <main class="content">${page(title)}</main></div></div>`
}
function page(p){
 const pages={dashboard:dashboardPage,users:usersPage,games:gamesPage,currencies:currenciesPage,products:productsPage,transactions:transactionsPage,permissions:permissionsPage,settings:settingsPage,backup:backupPage};
 return (pages[p]||dashboardPage)();
}
function head(title,sub=""){return `<div class="pagehead"><div><h1>${esc(title)}</h1>${sub?`<div class="muted">${esc(sub)}</div>`:""}</div></div>`}
function dashboardPage(){
 return head(t("dashboard"),t("welcome"))+`<div class="grid cards">
 ${stat(t("totalUsers"),state.users.length,"👥")}${stat(t("totalGames"),state.games.length,"🎮")}${stat(t("totalCurrencies"),state.currencies.length,"◈")}${stat(t("totalProducts"),state.products.length,"🛒")}${stat(t("totalTx"),state.transactions.length,"↔")}
 </div><div class="grid two section"><div class="card"><h2>${esc(t("quick"))}</h2><div class="actions">
 <button class="btn" data-modal="user">${esc(t("newUser"))}</button><button class="btn" data-modal="game">${esc(t("newGame"))}</button><button class="btn" data-modal="currency">${esc(t("newCurrency"))}</button><button class="btn" data-modal="product">${esc(t("newProduct"))}</button></div></div>
 <div class="card"><h2>${esc(t("account"))}</h2><div class="kpi"><span>${esc(t("user"))}</span><b>${esc(state.users.find(x=>x.id===state.session)?.username||"")}</b></div><div class="kpi" style="margin-top:10px"><span>${esc(t("role"))}</span><b>${esc(t("adminRole"))}</b></div></div></div>
 <div class="card section"><h2>${esc(t("transactions"))}</h2>${txTable(5)}</div>`
}
function stat(label,n,icon){return `<div class="card"><div class="statlabel">${icon} ${esc(label)}</div><div class="stat">${fmt(n)}</div></div>`}
function usersPage(){
 const q=state._q||"";
 let rows=state.users.filter(u=>(u.username+" "+(u.email||"")).toLowerCase().includes(q.toLowerCase()));
 return head(t("users"))+`<div class="card"><div class="actions"><input id="search" placeholder="${esc(t("search"))}" value="${esc(q)}" style="flex:1;min-width:180px"><button class="btn" data-modal="user">${esc(t("newUser"))}</button></div><div class="tablewrap section"><table class="table"><thead><tr><th>${esc(t("user"))}</th><th>${esc(t("email"))}</th><th>${esc(t("role"))}</th><th>${esc(t("status"))}</th><th>${esc(t("actions"))}</th></tr></thead><tbody>${rows.map(u=>`<tr><td><b>${esc(u.username)}</b></td><td>${esc(u.email||"—")}</td><td>${u.role==="admin"?t("adminRole"):t("userRole")}</td><td>${statusPill(u.status)}</td><td><div class="actions">${u.id!==state.session?`<button class="btn small secondary" data-user="${u.id}" data-act="${u.status==="frozen"?"unfreeze":"freeze"}">${esc(u.status==="frozen"?t("unfreeze"):t("freeze"))}</button><button class="btn small danger" data-user="${u.id}" data-act="delete">${esc(t("delete"))}</button>`:`<span class="muted">—</span>`}</div></td></tr>`).join("")||`<tr><td colspan="5" class="empty">${esc(t("noData"))}</td></tr>`}</tbody></table></div></div>`
}
function gamesPage(){
 return head(t("games"))+`<div class="card"><div class="actions"><button class="btn" data-modal="game">${esc(t("newGame"))}</button></div><div class="grid cards section">${state.games.map(g=>`<div class="card"><div class="kpi"><h2 style="margin:0">${esc(g.name)}</h2><span class="pill">${esc(g.code)}</span></div><p class="muted">${esc(g.description||"")}</p><div class="kpi"><span>${esc(t("version"))}</span><b>${esc(g.version||"1.0.0")}</b></div></div>`).join("")||`<div class="empty">${esc(t("noData"))}</div>`}</div></div>`
}
function currenciesPage(){
 return head(t("currencies"))+`<div class="card"><div class="actions"><button class="btn" data-modal="currency">${esc(t("newCurrency"))}</button></div><div class="tablewrap section"><table class="table"><thead><tr><th>${esc(t("name"))}</th><th>${esc(t("symbol"))}</th><th>${esc(t("game"))}</th><th>${esc(t("actions"))}</th></tr></thead><tbody>${state.currencies.map(c=>`<tr><td>${esc(c.name)}</td><td><b>${esc(c.symbol)}</b></td><td>${esc(state.games.find(g=>g.id===c.gameId)?.name||"—")}</td><td><button class="btn small danger" data-currency="${c.id}" data-act="delete">${esc(t("delete"))}</button></td></tr>`).join("")||`<tr><td colspan="4" class="empty">${esc(t("noData"))}</td></tr>`}</tbody></table></div></div>`
}
function productsPage(){
 return head(t("products"))+`<div class="card"><div class="actions"><button class="btn" data-modal="product">${esc(t("newProduct"))}</button></div><div class="grid cards section">${state.products.map(p=>`<div class="card"><div class="kpi"><h2 style="margin:0">${esc(p.name)}</h2><span class="pill">${fmt(p.price)} ${esc(state.currencies.find(c=>c.id===p.currencyId)?.symbol||"")}</span></div><p class="muted">${esc(p.description||"")}</p><button class="btn small danger" data-product="${p.id}" data-act="delete">${esc(t("delete"))}</button></div>`).join("")||`<div class="empty">${esc(t("noData"))}</div>`}</div></div>`
}
function txTable(limit){
 const arr=state.transactions.slice(-limit).reverse();
 return `<div class="tablewrap"><table class="table"><thead><tr><th>${esc(t("amount"))}</th><th>${esc(t("from"))}</th><th>${esc(t("to"))}</th><th>${esc(t("reason"))}</th></tr></thead><tbody>${arr.map(x=>`<tr><td>${fmt(x.amount)} ${esc(x.symbol||"")}</td><td>${esc(x.from||"—")}</td><td>${esc(x.to||"—")}</td><td>${esc(x.reason||"")}</td></tr>`).join("")||`<tr><td colspan="4" class="empty">${esc(t("noData"))}</td></tr>`}</tbody></table></div>`
}
function transactionsPage(){return head(t("transactions"))+`<div class="card">${txTable(100)}</div>`}
function permissionsPage(){
 return head(t("permissions"))+`<div class="card"><div class="tablewrap"><table class="table"><thead><tr><th>${esc(t("user"))}</th><th>${esc(t("game"))}</th><th>${esc(t("type"))}</th><th>${esc(t("actions"))}</th></tr></thead><tbody>${state.permissions.map(p=>{const u=state.users.find(x=>x.id===p.userId),g=state.games.find(x=>x.id===p.gameId);return `<tr><td>${esc(u?.username||"—")}</td><td>${esc(g?.name||"—")}</td><td><span class="pill">${esc(p.unlimited?t("unlimited"):t("normal"))}</span></td><td><button class="btn small secondary" data-perm="${p.id}" data-act="toggle">${esc(p.unlimited?t("revoke"):t("grant"))}</button></td></tr>`}).join("")||`<tr><td colspan="4" class="empty">${esc(t("noData"))}</td></tr>`}</tbody></table></div></div>`
}
function settingsPage(){
 return head(t("settings"))+`<div class="grid two"><div class="card"><h2>${esc(t("appearance"))}</h2><form id="settingsForm" class="form">
 <div class="field"><label>${esc(t("language"))}</label><select name="lang">${Object.entries(LANGS).map(([k,v])=>`<option value="${k}" ${k===state.settings.lang?"selected":""}>${v.name}</option>`).join("")}</select></div>
 <div class="field"><label>${esc(t("theme"))}</label><select name="theme"><option value="dark" ${state.settings.theme==="dark"?"selected":""}>${esc(t("dark"))}</option><option value="light" ${state.settings.theme==="light"?"selected":""}>${esc(t("light"))}</option></select></div>
 <div class="field"><label>${esc(t("name"))}</label><input name="bankName" value="${esc(state.settings.bankName)}"></div>
 <div class="field"><label>${esc(t("updateUrl"))}</label><input name="updateUrl" value="${esc(state.settings.updateUrl||"")}" placeholder="https://..."></div>
 <button class="btn">${esc(t("saveSettings"))}</button></form></div>
 <div class="card dangerzone"><h2>${esc(t("danger"))}</h2><p class="muted">${esc(t("warning"))}</p><button class="btn danger" id="deleteMine">${esc(t("deleteAccount"))}</button></div></div>`
}
function backupPage(){
 return head(t("backup"))+`<div class="grid two"><div class="card"><h2>${esc(t("export"))}</h2><p class="muted">${esc(t("backupHint"))}</p><button class="btn" id="export">${esc(t("export"))}</button></div><div class="card"><h2>${esc(t("import"))}</h2><input type="file" id="importFile" accept=".json,application/json"><p class="muted" style="font-size:12px">JSON backup only.</p></div></div>`
}
function modal(kind){
 let body="",title="";
 if(kind==="user"){title=t("newUser");body=`<form id="modalForm" class="form" data-kind="user"><div class="field"><label>${esc(t("user"))}</label><input name="username" required></div><div class="field"><label>${esc(t("email"))}</label><input name="email" type="email"></div><div class="field"><label>${esc(t("pass"))}</label><input name="password" type="password" required minlength="8"></div><div class="field"><label>${esc(t("role"))}</label><select name="role"><option value="user">${esc(t("userRole"))}</option><option value="admin">${esc(t("adminRole"))}</option></select></div><button class="btn">${esc(t("create"))}</button></form>`}
 if(kind==="game"){title=t("newGame");body=`<form id="modalForm" class="form" data-kind="game"><div class="field"><label>${esc(t("name"))}</label><input name="name" required></div><div class="field"><label>${esc(t("code"))}</label><input name="code" required></div><div class="field"><label>${esc(t("description"))}</label><textarea name="description"></textarea></div><div class="field"><label>${esc(t("version"))}</label><input name="version" value="1.0.0"></div><button class="btn">${esc(t("create"))}</button></form>`}
 if(kind==="currency"){title=t("newCurrency");body=`<form id="modalForm" class="form" data-kind="currency"><div class="field"><label>${esc(t("name"))}</label><input name="name" required></div><div class="field"><label>${esc(t("symbol"))}</label><input name="symbol" required></div><div class="field"><label>${esc(t("game"))}</label><select name="gameId">${state.games.map(g=>`<option value="${g.id}">${esc(g.name)}</option>`).join("")}</select></div><button class="btn">${esc(t("create"))}</button></form>`}
 if(kind==="product"){title=t("newProduct");body=`<form id="modalForm" class="form" data-kind="product"><div class="field"><label>${esc(t("name"))}</label><input name="name" required></div><div class="field"><label>${esc(t("description"))}</label><textarea name="description"></textarea></div><div class="field"><label>${esc(t("price"))}</label><input name="price" type="number" min="0" step="0.01" required></div><div class="field"><label>${esc(t("currencies"))}</label><select name="currencyId">${state.currencies.map(c=>`<option value="${c.id}">${esc(c.name)} (${esc(c.symbol)})</option>`).join("")}</select></div><button class="btn">${esc(t("create"))}</button></form>`}
 return `<div class="modal" id="modal"><div class="modalbox"><div class="pagehead"><h2>${esc(title)}</h2><button class="iconbtn" id="closeModal">×</button></div>${body}</div></div>`
}
function bind(){
 document.querySelectorAll("[data-nav]").forEach(b=>b.onclick=()=>{state.page=b.dataset.nav;save();render()});
 const m=document.getElementById("menu");if(m)m.onclick=()=>document.getElementById("side").classList.toggle("open");
 const lo=document.getElementById("logout");if(lo)lo.onclick=()=>{state.session=null;save();render()};
 const lang=document.getElementById("lang");if(lang)lang.onchange=()=>{state.settings.lang=lang.value;save();render()};
 const auth=document.getElementById("authForm");if(auth)auth.onsubmit=async e=>{e.preventDefault();const u=document.getElementById("au").value.trim(),p=document.getElementById("ap").value; if(state.users.length===0){if(p!==document.getElementById("ac").value)return toast(t("passwordMismatch"));state.users.push({id:uid("usr"),username:u,email:"",hash:await hash(p),role:"admin",status:"active",created:Date.now()});state.session=state.users[0].id;seed();save();return render()}const found=state.users.find(x=>x.username.toLowerCase()===u.toLowerCase());if(!found||found.hash!==await hash(p)||found.status==="banned")return toast(t("loginBad"));if(found.status==="frozen")return toast(t("frozen"));state.session=found.id;save();render()};
 const sf=document.getElementById("search");if(sf)sf.oninput=()=>{state._q=sf.value;render();setTimeout(()=>{const x=document.getElementById("search");x?.focus();x?.setSelectionRange(x.value.length,x.value.length)},0)};
 document.querySelectorAll("[data-modal]").forEach(b=>b.onclick=()=>{document.body.insertAdjacentHTML("beforeend",modal(b.dataset.modal));bindModal()});
 document.querySelectorAll("[data-act]").forEach(b=>b.onclick=()=>action(b));
 const s=document.getElementById("settingsForm");if(s)s.onsubmit=e=>{e.preventDefault();const f=new FormData(s);state.settings.lang=f.get("lang");state.settings.theme=f.get("theme");state.settings.bankName=f.get("bankName")||"Modren Bank";state.settings.updateUrl=f.get("updateUrl")||"";save();render();toast(t("updated"))};
 const ex=document.getElementById("export");if(ex)ex.onclick=exportData;
 const im=document.getElementById("importFile");if(im)im.onchange=importData;
 const dm=document.getElementById("deleteMine");if(dm)dm.onclick=()=>{if(confirm(t("confirmDelete"))){state.users=state.users.filter(x=>x.id!==state.session);state.session=null;save();render()}};
}
function bindModal(){const c=document.getElementById("closeModal");if(c)c.onclick=()=>document.getElementById("modal").remove();const f=document.getElementById("modalForm");if(f)f.onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(f)),k=f.dataset.kind;if(k==="user"){if(state.users.some(x=>x.username.toLowerCase()===d.username.toLowerCase()))return toast(t("userExists"));hash(d.password).then(h=>{state.users.push({id:uid("usr"),username:d.username,email:d.email,hash:h,role:d.role,status:"active",created:Date.now()});save();document.getElementById("modal").remove();render();toast(t("created"))})}else{if(k==="game")state.games.push({id:uid("game"),name:d.name,code:d.code,description:d.description,version:d.version||"1.0.0"});if(k==="currency")state.currencies.push({id:uid("cur"),name:d.name,symbol:d.symbol,gameId:d.gameId});if(k==="product")state.products.push({id:uid("prd"),name:d.name,description:d.description,price:Number(d.price),currencyId:d.currencyId});save();document.getElementById("modal").remove();render();toast(t("created"))}}}
function action(b){
 const id=b.dataset.user||b.dataset.currency||b.dataset.product||b.dataset.perm, a=b.dataset.act;
 if(!confirm(t("confirmDelete")))return;
 if(b.dataset.user){const u=state.users.find(x=>x.id===id);if(a==="delete")state.users=state.users.filter(x=>x.id!==id);else if(a==="freeze")u.status="frozen";else if(a==="unfreeze")u.status="active"}
 if(b.dataset.currency&&a==="delete")state.currencies=state.currencies.filter(x=>x.id!==id);
 if(b.dataset.product&&a==="delete")state.products=state.products.filter(x=>x.id!==id);
 if(b.dataset.perm&&a==="toggle"){const p=state.permissions.find(x=>x.id===id);p.unlimited=!p.unlimited}
 save();render();toast(t("updated"))
}
function seed(){
 if(!state.games.length){state.games.push({id:uid("game"),name:"Modren Empire",code:"MODREN-EMPIRE",description:"Main game integration",version:"1.0.0"});}
 if(!state.currencies.length){state.currencies.push({id:uid("cur"),name:"MOD",symbol:"MOD",gameId:state.games[0].id});}
}
function exportData(){const clean=JSON.parse(JSON.stringify(state));const blob=new Blob([JSON.stringify(clean,null,2)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="modren-bank-backup.json";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function importData(e){const file=e.target.files?.[0];if(!file)return;const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result);if(!x||!x.users||!x.settings)throw 0;state=x;save();render();toast(t("updated"))}catch(_){toast("Invalid backup")}};r.readAsText(file)}
render();
})();
</script>
</body>
</html>
